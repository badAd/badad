# badAd rewrites
RewriteRule ^badad_order_history_([a-zA-Z0-9_]+)\.html$ order_history_html.php?y=$1
RewriteRule ^badad_order_history_([a-zA-Z0-9_]+)\.xml$ order_history_xml.php?y=$1 [L]
RewriteRule ^/?([0-9]+)/view\.html$ /view_single.php?a=$1 [L]
RewriteRule ^/?([a-zA-Z0-9]+)/([a-zA-Z0-9]+)/unsubscribe\.html$ /unsubscribe.php?l=$1&e=$2 [L]
RewriteRule ^/?([a-zA-Z0-9]+)/([a-zA-Z0-9]+)/newsletter_unsubscribe\.html$ /newsletter_unsubscribe.php?l=$1&e=$2 [L]
RewriteRule ^/?([a-zA-Z0-9\._-]+)_([0-9_-]+)_([0-9_-]+)-([0-9_-]+)_badad_site_stats\.xml$ /partner_site_stats_xml.php?i=$2&s=$3&e=$4 [L]
RewriteRule ^/?([0-9_-]+)_([0-9_-]+)-([0-9_-]+)_badad_business_ad_stats\.xml$ /business_ad_stats_xml.php?i=$1&s=$2&e=$3 [L]
RewriteRule ^/?([0-9_-]+)_([0-9_-]+)-([0-9_-]+)_badad_podcast_ad_stats\.xml$ /podcast_ad_stats_xml.php?i=$1&s=$2&e=$3 [L]
RewriteRule ^/?([0-9_-]+)_badad_ad_stats\.xml$ /ad_stats_xml.php?i=$1 [L]
RewriteRule ^/?([0-9_-]+)_badad_pod_stats\.xml$ /pod_stats_xml.php?i=$1 [L]
RewriteRule ^/?([a-zA-Z0-9]+)/site\.html$ /site.php?l=$1 [L]
RewriteRule ^/?([a-zA-Z0-9]+)/resite\.html$ /resite.php?l=$1 [L]
